# Copy to .env next to docker-compose.yml. Never commit .env.

# Which services run on this host. During a test deploy leave out "tunnel"
# (and keep Telegram tokens out of the agent options) so nothing clashes with
# the instance that is still live elsewhere.
COMPOSE_PROFILES=yuvomi,agents,tunnel

# Home Assistant MCP endpoint as seen from this host.
#   At home on HA OS:   http://homeassistant:8123/api/mcp  (add-on network only)
#   Anywhere else:      https://<your HA remote URL>/api/mcp
HA_MCP_URL=https://casa.example.com/api/mcp

# Add-on style options, base64 of the JSON (scripts/encode-options.sh makes these).
# agents: same JSON as the AI Agents add-on options; the Yuvomi MCP url must be
#         http://yuvomi:3000/mcp here.
AGENTS_OPTIONS_B64=
# yuvomi: same JSON as the Yuvomi add-on options (incl. db_encryption_key, which
#         must match the database in ./data/yuvomi).
YUVOMI_OPTIONS_B64=

# Remotely managed Cloudflare tunnel token (Zero Trust > Networks > Tunnels).
CF_TUNNEL_TOKEN=

# Optional overrides
# AGENTS_SUBNET=172.28.0.0/24
# YUVOMI_PORT=3000
# AGENTS_WEBUI_PORT=8765
